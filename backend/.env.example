APP_ENV=development
# Enable only for local development without an email or SMS provider.
DEV_OTP_MODE=false
SECRET_KEY=replace-with-a-long-random-value
DATABASE_URL=sqlite:///./onpay.db
FRONTEND_ORIGIN=http://localhost:5173
# Comma-separated exact browser origins for deployed and preview frontends; never use * with credentials.
FRONTEND_ORIGINS=
SESSION_TTL_HOURS=168
SESSION_COOKIE_SAMESITE=lax
OTP_TTL_MINUTES=5
OTP_RESEND_SECONDS=30
OTP_MAX_ATTEMPTS=5

# Email OTP delivery through Resend. Set the API key only in the backend environment.
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_replace_with_resend_api_key
EMAIL_FROM=ONPay <verified-sender@example.com>

# Optional mobile OTP through Twilio Verify. Not needed for email OTP.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_PHONE_NUMBER=

# Reverse geocoding for readable location names; use an identifying app name and operator contact for production.
REVERSE_GEOCODER_URL=https://nominatim.openstreetmap.org/reverse
REVERSE_GEOCODER_USER_AGENT=ONPay/0.1
REVERSE_GEOCODER_ATTRIBUTION=© OpenStreetMap contributors

YOUPI_WEBHOOK_SECRET=
# Server-only key for independently reconciled settlement; leave unset until operated securely.
RECONCILIATION_TOKEN=
